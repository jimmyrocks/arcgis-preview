{
  "name": "arcgis-preview",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Frontend-only ArcGIS REST preview (MapLibre + @opendataland/source-arcgis)",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix ../source-arcgis-rest run build",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsc -p tests/tsconfig.json && node -e \"require('fs').writeFileSync('tests/dist/package.json','{\\n \\\"name\\\": \\\"arcgis-preview-tests\\\",\\n \\\"version\\\": \\\"0.0.0\\\",\\n \\\"private\\\": true,\\n \\\"type\\\": \\\"commonjs\\\"\\n}');\" && node tests/dist/tests/simple.test.js"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lint": "^6.9.6",
    "@headlessui/react": "^2.2.10",
    "@opendataland/source-arcgis": "file:../source-arcgis-rest",
    "@tanstack/react-table": "^8.21.3",
    "@types/geojson": "^7946.0.16",
    "@uiw/react-codemirror": "^4.25.10",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
