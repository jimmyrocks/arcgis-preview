{
  "name": "arcgis-preview",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Frontend-only ArcGIS REST preview (MapLibre + @opendataland/source-arcgis)",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix ../source-arcgis-rest run build",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh",
    "test": "tsc -p tests/tsconfig.json && node -e \"require('fs').writeFileSync('tests/dist/package.json','{\\n \\\"name\\\": \\\"arcgis-preview-tests\\\",\\n \\\"version\\\": \\\"0.0.0\\\",\\n \\\"private\\\": true,\\n \\\"type\\\": \\\"commonjs\\\"\\n}');\" && node tests/dist/tests/simple.test.js",
    "test:browser": "tsc -p tests/browser/tsconfig.json && npm run build && playwright test"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lint": "^6.9.7",
    "@headlessui/react": "^2.2.10",
    "@maplibre/geojson-vt": "^6.1.1",
    "@maplibre/vt-pbf": "^4.3.2",
    "@opendataland/source-arcgis": "file:../source-arcgis-rest",
    "@types/geojson": "^7946.0.16",
    "@uiw/react-codemirror": "^4.25.11",
    "maplibre-gl": "6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-toastify": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
