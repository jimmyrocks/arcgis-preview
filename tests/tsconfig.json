{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "..",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "../src/lib/ids.ts",
    "../src/lib/arcgis.ts",
    "../src/lib/arcgisDescription.ts",
    "../src/lib/whereBuilder.ts",
    "../src/lib/mapMath.ts",
    "../src/lib/arcgisInteger.ts",
    "../src/lib/exactJson.ts",
    "../src/lib/csv.ts",
    "../src/lib/kml.ts",
    "./**/*.ts"
  ],
  "exclude": ["./browser"]
}
